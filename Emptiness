  <script>
    /* Definition of data schema and categories */
    const STORAGE_KEY = 'diagrama_do_vazio_v1';

    const CATEGORIES = {
      pessoas: {
        id: 'pessoas',
        title: 'Pessoas & Presenças',
        subtitle: '10 vínculos, conversas, vozes ou presenças (físicas ou lembradas) que ancoram seu dia.',
        colorTag: 'Índigo Noturno (#0a1128)',
        count: 10,
        baseColor: [10, 17, 40], // Deep Indigo RGB
        icon: 'users',
        colorClass: 'text-blue-400',
        badgeBg: 'bg-blue-950/40 text-blue-300 border-blue-900/40'
      },
      funcional: {
        id: 'funcional',
        title: 'O que Gosto & Rotina Funcional',
        subtitle: '10 ações que você aprecia ou tarefas vitais (banho, água, alimentação, arrumação) para se manter funcional.',
        colorTag: 'Sépia & Musgo (#1b2612)',
        count: 10,
        baseColor: [27, 38, 18], // Deep Earth / Moss RGB
        icon: 'sparkle',
        colorClass: 'text-emerald-400',
        badgeBg: 'bg-emerald-950/40 text-emerald-300 border-emerald-900/40'
      },
      musicas: {
        id: 'musicas',
        title: 'Músicas do Dia',
        subtitle: '5 músicas ou sonoridades que tocaram ou ecoaram na sua mente hoje.',
        colorTag: 'Carmim Sombrio (#2a0815)',
        count: 5,
        baseColor: [42, 8, 21], // Deep Wine RGB
        icon: 'music',
        colorClass: 'text-rose-400',
        badgeBg: 'bg-rose-950/40 text-rose-300 border-rose-900/40'
      },
      criativo: {
        id: 'criativo',
        title: 'Tarefas Criativas',
        subtitle: '3 gestos de criação, raciocínio, escrita ou elaboração de algo com suas mãos e pensamentos.',
        colorTag: 'Grafite & Carvão (#121214)',
        count: 3,
        baseColor: [18, 18, 20], // Deep Charcoal RGB
        icon: 'palette',
        colorClass: 'text-stone-300',
        badgeBg: 'bg-stone-800 text-stone-300 border-stone-700'
      }
    };

    const INTENSITY_LABELS = {
      1: 'Sutil (1)',
      2: 'Presente (2)',
      3: 'Importante (3)',
      4: 'Marcante (4)',
      5: 'Vital (5)'
    };

    // State initialization
    let currentCategory = 'pessoas';
    let appData = initializeData();

    function initializeData() {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) {
        try {
          return JSON.parse(saved);
        } catch (e) {
          console.error("Falha ao recuperar dados do localStorage", e);
        }
      }

      // Default blank state
      const initial = {};
      Object.keys(CATEGORIES).forEach(catKey => {
        initial[catKey] = [];
        for (let i = 0; i < CATEGORIES[catKey].count; i++) {
          initial[catKey].push({
            id: `${catKey}_${i}`,
            text: '',
            intensity: 3,
            checked: false,
            // Random parameters to generate unique deterministic watercolor blobs
            angle: (i / CATEGORIES[catKey].count) * (Math.PI * 2) + (Math.random() * 0.3 - 0.15),
            distRatio: 0.15 + (Math.random() * 0.7),
            seed: Math.random() * 1000
          });
        }
      });
      return initial;
    }

    function saveData() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(appData));
      } catch (e) {
        console.error("Erro ao salvar", e);
      }
    }

    function renderItems() {
      const container = document.getElementById('itemsContainer');
      const catConfig = CATEGORIES[currentCategory];
      const items = appData[currentCategory];

      // Update header details
      document.getElementById('categoryTitle').textContent = catConfig.title;
      document.getElementById('categoryDescription').textContent = catConfig.subtitle;
      document.getElementById('categoryColorTag').textContent = catConfig.colorTag;

      container.innerHTML = '';

      items.forEach((item, index) => {
        const row = document.createElement('div');
        row.className = `p-3 sm:p-4 rounded-xl border transition-all duration-300 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 ${
          item.checked 
            ? 'bg-stone-900/90 border-stone-700/80 shadow-md' 
            : 'bg-stone-900/30 border-stone-800/60 hover:border-stone-700/60'
        }`;

        // Left checkbox + input
        const leftGroup = document.createElement('div');
        leftGroup.className = 'flex items-center gap-3 w-full sm:w-auto flex-1';

        // Checkbox
        const checkbox = document.createElement('input');
        checkbox.type = 'checkbox';
        checkbox.checked = item.checked;
        checkbox.className = 'w-4 h-4 rounded text-stone-900 bg-stone-950 border-stone-700 focus:ring-0 focus:ring-offset-0 cursor-pointer accent-stone-200';
        checkbox.onchange = (e) => {
          item.checked = e.target.checked;
          // If checked but empty, provide a gentle auto-fill suggestion prompt
          if (item.checked && !item.text.trim()) {
            input.focus();
          }
          onDataChanged();
          renderItems();
        };

        // Text input
        const input = document.createElement('input');
        input.type = 'text';
        input.value = item.text;
        input.placeholder = `${index + 1}. Nomeie ou recorde esta presença...`;
        input.className = `w-full bg-transparent border-0 border-b border-stone-800 focus:border-stone-500 focus:outline-none text-xs sm:text-sm py-1 transition-colors ${
          item.checked ? 'text-stone-100 font-medium' : 'text-stone-400'
        }`;
        input.oninput = (e) => {
          item.text = e.target.value;
          if (item.text.trim().length > 0 && !item.checked) {
            item.checked = true;
            checkbox.checked = true;
          }
          saveData();
          updateCanvasAndStats();
        };

        leftGroup.appendChild(checkbox);
        leftGroup.appendChild(input);

        // Right group: Intensity selector (1-5)
        const rightGroup = document.createElement('div');
        rightGroup.className = 'flex items-center gap-2 self-end sm:self-auto flex-shrink-0';

        const intensityLabel = document.createElement('span');
        intensityLabel.className = 'text-[11px] font-mono text-stone-500 mr-1 hidden sm:inline';
        intensityLabel.textContent = 'Peso:';

        rightGroup.appendChild(intensityLabel);

        // Segmented buttons for intensity 1 to 5
        const segContainer = document.createElement('div');
        segContainer.className = 'flex items-center rounded-lg bg-stone-950 p-1 border border-stone-800 gap-0.5';

        for (let lvl = 1; lvl <= 5; lvl++) {
          const btn = document.createElement('button');
          btn.type = 'button';
          const isActive = item.intensity === lvl;
          btn.className = `w-6 h-6 rounded text-[11px] font-semibold flex items-center justify-center transition-all ${
            isActive 
              ? 'bg-stone-200 text-stone-950 shadow' 
              : 'text-stone-500 hover:text-stone-300 hover:bg-stone-900'
          }`;
          btn.textContent = lvl;
          btn.title = INTENSITY_LABELS[lvl];
          btn.onclick = () => {
            item.intensity = lvl;
            if (!item.checked && item.text.trim().length > 0) {
              item.checked = true;
            }
            saveData();
            onDataChanged();
            renderItems();
          };
          segContainer.appendChild(btn);
        }

        rightGroup.appendChild(segContainer);

        row.appendChild(leftGroup);
        row.appendChild(rightGroup);
        container.appendChild(row);
      });

      // Update badge counters
      updateBadges();
      lucide.createIcons();
    }

    function updateBadges() {
      Object.keys(CATEGORIES).forEach(cat => {
        const items = appData[cat];
        const completed = items.filter(it => it.checked && it.text.trim().length > 0).length;
        const total = CATEGORIES[cat].count;
        const badge = document.getElementById(`badge-${cat}`);
        if (badge) {
          badge.textContent = `${completed}/${total}`;
          if (completed === total) {
            badge.className = 'badge text-xs px-1.5 py-0.5 rounded-full bg-emerald-950/80 text-emerald-400 font-mono border border-emerald-800/60';
          } else if (completed > 0) {
            badge.className = 'badge text-xs px-1.5 py-0.5 rounded-full bg-stone-800 text-stone-200 font-mono';
          } else {
            badge.className = 'badge text-xs px-1.5 py-0.5 rounded-full bg-stone-900 text-stone-500 font-mono';
          }
        }
      });
    }

    const canvas = document.getElementById('voidCanvas');
    const ctx = canvas.getContext('2d');

    function onDataChanged() {
      saveData();
      updateCanvasAndStats();
    }

    function calculateTotalStats() {
      let totalSlots = 0;
      let rememberedCount = 0;
      let currentAccumulatedWeight = 0;
      let maxPossibleWeight = 0;

      Object.keys(CATEGORIES).forEach(catKey => {
        const count = CATEGORIES[catKey].count;
        totalSlots += count;
        maxPossibleWeight += count * 5; // max weight if all are intensity 5

        appData[catKey].forEach(item => {
          if (item.checked && item.text.trim().length > 0) {
            rememberedCount++;
            currentAccumulatedWeight += item.intensity;
          }
        });
      });

      // Ratio from 0 to 1
      const densityRatio = Math.min(1, currentAccumulatedWeight / (totalSlots * 3.8)); 
      // 3.8 average intensity allows hitting 100% when all 28 items are documented thoughtfully
      const percentage = Math.round(densityRatio * 100);

      return {
        totalSlots,
        rememberedCount,
        densityRatio,
        percentage
      };
    }

    function updateCanvasAndStats() {
      const stats = calculateTotalStats();

      // UI Elements update
      document.getElementById('densityPercentage').textContent = `${stats.percentage}%`;
      const densityBar = document.getElementById('densityBar');
      densityBar.style.width = `${stats.percentage}%`;

      // Header dot indicator
      const headerDot = document.getElementById('headerDot');
      if (stats.percentage === 100) {
        headerDot.className = 'w-2.5 h-2.5 rounded-full bg-black border border-stone-800 shadow';
      } else {
        const lightness = 100 - (stats.percentage * 0.9);
        headerDot.style.backgroundColor = `hsl(0, 0%, ${lightness}%)`;
      }

      // Dynamic DBT quotes based on saturation degree
      const quoteEl = document.getElementById('stateQuote');
      const subQuoteEl = document.getElementById('subQuote');
      subQuoteEl.textContent = `${stats.rememberedCount} de ${stats.totalSlots} âncoras lembradas.`;

      if (stats.percentage === 0) {
        quoteEl.textContent = `"A tela está em silêncio. Um vazio aparente à espera das memórias que sustentam o dia."`;
      } else if (stats.percentage < 25) {
        quoteEl.textContent = `"Primeiros pigmentos de presença. A dormência cede lugar aos primeiros detalhes factuais."`;
      } else if (stats.percentage < 55) {
        quoteEl.textContent = `"O peso das ações ganha corpo. O dia começa a revelar as suas marcas reais."`;
      } else if (stats.percentage < 85) {
        quoteEl.textContent = `"A densidade do real se consolida. O que parecia ausência revela sua matéria espessa."`;
      } else if (stats.percentage < 100) {
        quoteEl.textContent = `"Quase opaco. Restam apenas lampejos tênues para a totalidade da memória."`;
      } else {
        quoteEl.textContent = `"Preto Pleno: O vazio está totalmente repleto. Nada ficou sem testemunha."`;
      }

      // Pulsing effect when fully saturated
      const canvasFrame = document.getElementById('canvasFrame');
      if (stats.percentage >= 100) {
        canvasFrame.classList.add('full-density');
        canvasFrame.style.borderColor = '#000000';
      } else {
        canvasFrame.classList.remove('full-density');
        canvasFrame.style.borderColor = 'rgba(87, 83, 78, 0.6)';
      }

      // Ambient glow
      const ambientGlow = document.getElementById('ambientGlow');
      if (stats.percentage >= 100) {
        ambientGlow.className = 'absolute inset-4 rounded-full blur-2xl transition-all duration-1000 opacity-90 bg-black';
      } else {
        const glowVal = Math.round(220 - (stats.percentage * 2));
        ambientGlow.style.backgroundColor = `rgb(${glowVal}, ${glowVal}, ${glowVal})`;
      }

      // Render the subtractive ink painting on canvas
      drawSubtractiveCanvas(stats.densityRatio);
    }

    function drawSubtractiveCanvas(overallDensity) {
      const w = canvas.width;
      const h = canvas.height;
      const center = w / 2;

      // Reset canvas to absolute white
      ctx.globalCompositeOperation = 'source-over';
      ctx.fillStyle = '#FFFFFF';
      ctx.fillRect(0, 0, w, h);

      // We use 'multiply' composite operation to achieve true subtractive ink mixing
      ctx.globalCompositeOperation = 'multiply';

      // 1. Draw each individual remembered item as a rich watercolor bloom
      Object.keys(CATEGORIES).forEach(catKey => {
        const catConfig = CATEGORIES[catKey];
        const [baseR, baseG, baseB] = catConfig.baseColor;
        const items = appData[catKey];

        items.forEach((item, idx) => {
          if (!item.checked || !item.text.trim()) return;

          const intensity = item.intensity || 1;
          const rad = (item.angle || (idx * 0.6)) + (Math.sin(idx) * 0.1);
          const distance = (item.distRatio || 0.4) * (w * 0.38);

          const cx = center + Math.cos(rad) * distance;
          const cy = center + Math.sin(rad) * distance;

          // Radius depends on intensity
          const blobRadius = (w * 0.22) * (0.6 + (intensity * 0.15));

          // Draw organic multi-layered splash
          drawOrganicBlob(cx, cy, blobRadius, baseR, baseG, baseB, intensity);
        });
      });

      // 2. Global overlay saturation pass
      // As overall density climbs, overall ambient ink wash washes over to guarantee black convergence
      if (overallDensity > 0.02) {
        ctx.globalCompositeOperation = 'multiply';

        // Repeated dense passes as percentage approaches 100%
        const passes = Math.floor(overallDensity * 6);
        for (let p = 0; p < passes; p++) {
          const grad = ctx.createRadialGradient(center, center, 0, center, center, center * 1.05);
          // Dark charcoal ink
          grad.addColorStop(0, `rgba(5, 5, 8, ${0.4 + (overallDensity * 0.5)})`);
          grad.addColorStop(0.7, `rgba(10, 10, 15, ${0.35 + (overallDensity * 0.55)})`);
          grad.addColorStop(1, `rgba(2, 2, 5, ${0.5 + (overallDensity * 0.5)})`);

          ctx.fillStyle = grad;
          ctx.beginPath();
          ctx.arc(center, center, center, 0, Math.PI * 2);
          ctx.fill();
        }

        // If completely full (100%), stamp pure absolute black for crisp totality
        if (overallDensity >= 0.999) {
          ctx.globalCompositeOperation = 'source-over';
          ctx.fillStyle = '#000000';
          ctx.beginPath();
          ctx.arc(center, center, center, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      // Draw subtle circular vignette border inside canvas
      ctx.globalCompositeOperation = 'source-over';
      ctx.lineWidth = 14;
      ctx.strokeStyle = '#0c0a09';
      ctx.beginPath();
      ctx.arc(center, center, center - 7, 0, Math.PI * 2);
      ctx.stroke();
    }

    // Helper for procedural ink blooms with organic water edges
    function drawOrganicBlob(x, y, radius, r, g, b, intensity) {
      const alphaBase = 0.35 + (intensity * 0.12);
      const layers = 3 + intensity;

      for (let l = 0; l < layers; l++) {
        const curRadius = radius * (0.6 + (l * 0.15));
        const grad = ctx.createRadialGradient(x, y, 0, x, y, curRadius);
        
        grad.addColorStop(0, `rgba(${r}, ${g}, ${b}, ${alphaBase})`);
        grad.addColorStop(0.6, `rgba(${Math.max(0, r - 5)}, ${Math.max(0, g - 5)}, ${Math.max(0, b - 5)}, ${alphaBase * 0.8})`);
        grad.addColorStop(1, `rgba(255, 255, 255, 1)`); // White ends cleanly in multiply blend mode

        ctx.fillStyle = grad;
        ctx.beginPath();

        // Polygon with randomized vertices to imitate irregular watercolor bleed
        const points = 16;
        for (let i = 0; i < points; i++) {
          const theta = (i / points) * Math.PI * 2;
          const jitter = 0.85 + (Math.sin(i * 3.5 + l) * 0.18);
          const px = x + Math.cos(theta) * curRadius * jitter;
          const py = y + Math.sin(theta) * curRadius * jitter;
          if (i === 0) ctx.moveTo(px, py);
          else ctx.lineTo(px, py);
        }
        ctx.closePath();
        ctx.fill();
      }
    }

